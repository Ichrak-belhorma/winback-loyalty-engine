# Copy to .env and adjust. Defaults run fully in mock mode with no API keys.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

# Database (docker compose uses the postgres service; unset falls back to SQLite for local dev)
POSTGRES_DB=winback
POSTGRES_USER=winback
POSTGRES_PASSWORD=winback
DATABASE_URL=postgres://winback:winback@postgres:5432/winback

# Queue / scheduler
REDIS_URL=redis://redis:6379/0

# Integrations: mocks by default, no keys needed
USE_MOCKS=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=5
STORE_NAME=Swift Basket
MAILTRAP_API_TOKEN=
MAILTRAP_SENDER_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Compliance
QUIET_HOURS_START=21
QUIET_HOURS_END=8
WEEKLY_MESSAGE_CAP=3
DEFAULT_CUSTOMER_TIMEZONE=America/New_York
